{
  "name": "strihnuto-web",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-15",
  // Existing public workers.dev address; no custom routes or DNS changes.
  "workers_dev": true,
  // Preserve dashboard variables, including MAIL_FROM once manually configured.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SITE_ORIGIN": "https://strihnuto.cz"
  },
  "send_email": [
    { "name": "CONTACT_EMAIL", "destination_address": "imperium@isb7.cz" }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ]
  // MAIL_FROM: manually configure a sender on an activated Email Routing domain.
  // TURNSTILE_SECRET_KEY: Cloudflare Worker secret only; never commit its value.
}
